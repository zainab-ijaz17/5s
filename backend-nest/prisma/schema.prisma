generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  power_user
  bu_manager
  auditor
  user
}

model User {
  id               String       @id @default(cuid())
  employeeId       Int?         @unique
  name             String
  email            String       @unique
  passwordHash     String
  role             Role         @default(user)
  businessUnit     String?
  section          String?
  refreshTokenHash String?
  assessments      Assessment[] @relation("AssessmentCreatedBy")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Question {
  id        String   @id @default(cuid())
  question  String
  details   String?
  category  String   @default("SORT")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assessment {
  id            String           @id
  company       String
  bu            String?
  section       String?
  auditorName   String
  auditeeName   String
  auditorEmail  String?
  auditeeEmail  String?
  userName      String?
  employeeId    Int?
  score         Int
  isFlagged     Boolean          @default(false)
  followUpDueAt DateTime?
  followUpSent  Boolean          @default(false)
  resolved      Boolean          @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  createdById   String?
  createdBy     User?            @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items         AssessmentItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([bu, section, isFlagged])
}

model AssessmentItem {
  id           String       @id @default(cuid())
  assessmentId String
  question     String
  answer       String
  remarks      String?
  isFlagged    Boolean      @default(false)
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  createdAt    DateTime     @default(now())

  @@index([assessmentId])
}

model Attachment {
  id               String         @id @default(cuid())
  assessmentItemId String
  localPath        String?
  url              String?
  attachment       AssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([assessmentItemId])
}

model GembaObservation {
  id                        String                  @id @default(cuid())
  title                     String
  location                  String
  category                  String
  status                    String                  @default("In-progress")
  assignedEmployeeNumber    String
  assignedEmployeeName      String?
  createdByEmployeeNumber   String
  createdByName             String?
  remarks                   String                  @db.Text
  company                   String
  bu                        String?
  section                   String?
  machineValue              String?
  afterRemarks              String?                 @db.Text
  completedByEmployeeNumber String?
  completedByName           String?
  completedAt               DateTime?
  photos                    GembaObservationPhoto[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([status])
  @@index([assignedEmployeeNumber])
  @@index([createdByEmployeeNumber])
  @@index([createdAt])
}

model GembaObservationPhoto {
  id            String           @id @default(cuid())
  observationId String
  observation   GembaObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  kind          String
  url           String
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())

  @@index([observationId, kind])
}

model GembaRole {
  id         String           @id @default(cuid())
  name       String           @unique
  adminUsers GembaAdminUser[]
  createdAt  DateTime         @default(now())

  @@map("gemba_roles")
}

model GembaAdminUser {
  id             String    @id @default(cuid())
  employeeNumber String    @unique
  roleId         String
  role           GembaRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([roleId])
  @@map("admin_users")
}

// ─── Skill Matrix ───────────────────────────────────────────────────────────

enum SkillMatrixUserStatus {
  Active
  Inactive
}

enum SkillMatrixAssessmentStatus {
  draft
  submitted
  reviewed
  approved
}

enum SkillMatrixTrainingAssignmentStatus {
  Scheduled
  InProgress
  Completed
  Cancelled
}

model SkillMatrixRole {
  id        String             @id @default(cuid())
  name      String             @unique
  users     SkillMatrixUser[]
  createdAt DateTime           @default(now())

  @@map("sm_roles")
}

model SkillMatrixLevel {
  id              String                        @id @default(cuid())
  code            String                        @unique
  sortOrder       Int                           @default(0)
  users           SkillMatrixUser[]
  applicableSkills SkillMatrixSkillApplicableLevel[]
  skillRequirements SkillMatrixSkillRequirement[]
  createdAt       DateTime                      @default(now())

  @@map("sm_levels")
}

model SkillMatrixCategory {
  id        String              @id @default(cuid())
  name      String              @unique
  users     SkillMatrixUser[]
  skills    SkillMatrixSkill[]
  createdAt DateTime            @default(now())

  @@map("sm_categories")
}

model SkillMatrixUser {
  id               String                   @id @default(cuid())
  fullName         String
  email            String                   @unique
  passwordHash     String
  employeeNumber   String                   @unique
  roleId           String
  role             SkillMatrixRole          @relation(fields: [roleId], references: [id])
  levelId          String?
  level            SkillMatrixLevel?        @relation(fields: [levelId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         SkillMatrixCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  department       String?
  areaLine         String?
  designation      String?
  lineManagerId    String?
  lineManager      SkillMatrixUser?         @relation("SmReports", fields: [lineManagerId], references: [id], onDelete: SetNull)
  directReports    SkillMatrixUser[]        @relation("SmReports")
  status           SkillMatrixUserStatus    @default(Active)
  photoUrl         String?
  dateOfJoining    DateTime?
  assessments      SkillMatrixAssessment[]
  trainingAssignments SkillMatrixTrainingAssignment[] @relation("SmTrainingWorker")
  trainingsAssigned   SkillMatrixTrainingAssignment[] @relation("SmTrainingAssigner")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([roleId])
  @@index([lineManagerId])
  @@index([levelId])
  @@map("sm_users")
}

model SkillMatrixTraining {
  id          String                          @id @default(cuid())
  name        String                          @unique
  description String?                         @db.Text
  durationHours Float?
  assignments SkillMatrixTrainingAssignment[]
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@map("sm_trainings")
}

model SkillMatrixSkill {
  id              String                          @id @default(cuid())
  name            String
  categoryId      String
  category        SkillMatrixCategory             @relation(fields: [categoryId], references: [id])
  department      String?
  area            String?
  description     String?                         @db.Text
  applicableLevels SkillMatrixSkillApplicableLevel[]
  requirements    SkillMatrixSkillRequirement[]
  assessmentLines SkillMatrixAssessmentLine[]
  trainingLinks   SkillMatrixTrainingAssignment[]
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@unique([categoryId, name])
  @@map("sm_skills")
}

model SkillMatrixSkillApplicableLevel {
  skillId String
  levelId String
  skill   SkillMatrixSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level   SkillMatrixLevel   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([skillId, levelId])
  @@map("sm_skill_applicable_levels")
}

model SkillMatrixSkillRequirement {
  skillId        String
  levelId        String
  requiredLevel  Int
  skill          SkillMatrixSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level          SkillMatrixLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([skillId, levelId])
  @@map("sm_skill_requirements")
}

model SkillMatrixAssessmentCycle {
  id        String                  @id @default(cuid())
  name      String                  @unique
  label     String
  dueDate   DateTime?
  isActive  Boolean                 @default(true)
  assessments SkillMatrixAssessment[]
  createdAt DateTime                @default(now())

  @@map("sm_assessment_cycles")
}

model SkillMatrixAssessment {
  id          String                      @id @default(cuid())
  userId      String
  user        SkillMatrixUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId     String
  cycle       SkillMatrixAssessmentCycle  @relation(fields: [cycleId], references: [id])
  status      SkillMatrixAssessmentStatus @default(draft)
  submittedAt DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  lines       SkillMatrixAssessmentLine[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([userId, cycleId])
  @@index([status])
  @@map("sm_assessments")
}

model SkillMatrixAssessmentLine {
  id              String                @id @default(cuid())
  assessmentId    String
  assessment      SkillMatrixAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skillId         String
  skill           SkillMatrixSkill      @relation(fields: [skillId], references: [id])
  requiredLevel   Int
  selfRating      Int?
  selfComment     String?               @db.Text
  managerRating   Int?
  managerComment  String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([assessmentId, skillId])
  @@index([assessmentId])
  @@map("sm_assessment_lines")
}

model SkillMatrixTrainingAssignment {
  id           String                              @id @default(cuid())
  workerId     String
  worker       SkillMatrixUser                     @relation("SmTrainingWorker", fields: [workerId], references: [id], onDelete: Cascade)
  trainingId   String
  training     SkillMatrixTraining                 @relation(fields: [trainingId], references: [id])
  skillId      String?
  skill        SkillMatrixSkill?                   @relation(fields: [skillId], references: [id], onDelete: SetNull)
  assignedById String
  assignedBy   SkillMatrixUser                     @relation("SmTrainingAssigner", fields: [assignedById], references: [id])
  dueDate      DateTime?
  status       SkillMatrixTrainingAssignmentStatus @default(Scheduled)
  createdAt    DateTime                            @default(now())
  updatedAt    DateTime                            @updatedAt

  @@index([workerId])
  @@map("sm_training_assignments")
}
