<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome may trust newer CAs before the device system store is updated (e.g. Sectigo R46). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">packagesgroup.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/sectigo_root_r46" />
        </trust-anchors>
    </domain-config>
</network-security-config>
